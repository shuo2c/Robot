{
  "permissions": {
    "allow": [
      "Bash(bash sync.sh:*)",
      "Bash(python -m memory:*)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/on-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/sync.sh\" stopped \"thamus: 会话停止时自动同步\""
          }
        ]
      }
    ]
  }
}
